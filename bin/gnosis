#!/bin/sh
# Gnosis のランチャー（Linux / macOS）。
#
#   gnosis                 現在の端末（Bash 等）で普通の Vim を起動。端末外からは端末を新規起動
#   gnosis --app           旧 Electron アプリを明示したときだけ起動（任意）
#   gnosis --gui           GUI 版 Vim（gvim / MacVim）で起動
#   gnosis --tui           今の端末の Vim で起動（--terminal も同じ）
#   gnosis --new-terminal  新しい端末ウィンドウを開いて、その中の Vim で起動
#   gnosis [ノート.md …]   そのノートを開く（起動画面は出さない）
#   gnosis --where         Gnosis のフォルダ・Gnosis ホーム・使う vimrc を表示
#
# Vim は、Gnosis 専用の vimrc（<Gnosis ホーム>/vimrc。無ければ本体の vimrc_gnosis）で起動する。
# ふだんの ~/.vimrc・~/.vim は読まない・変えない。ふつうに vim を起動すれば今までどおり。
#
# 端末の文字サイズ・最大化: 端末ごとに方法が違うため、--new-terminal で開く端末のうち、
# 対応しているもの（kitty / alacritty / wezterm / xterm）だけに、vault の設定の文字サイズと
# 最大化を渡す。それ以外の端末（gnome-terminal / konsole など）は、その端末の設定のまま。
# 今の端末（--tui）の文字やウィンドウは変えない。
set -eu

# ---- このファイルの場所（シンボリックリンクをたどる）から Gnosis のフォルダを求める
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
GNOSIS_DIR=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)
export GNOSIS_DIR

if [ -n "${GNOSIS_HOME:-}" ]; then
  :
elif [ "$(uname -s)" = Darwin ]; then
  GNOSIS_HOME="$HOME/Library/Application Support/Gnosis"
else
  GNOSIS_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/gnosis"
fi
export GNOSIS_HOME

if [ -n "${GNOSIS_VIMRC:-}" ]; then
  VIMRC=$GNOSIS_VIMRC
elif [ -f "$GNOSIS_HOME/vimrc" ]; then
  VIMRC="$GNOSIS_HOME/vimrc"
else
  VIMRC="$GNOSIS_DIR/vimrc_gnosis"
fi
export GNOSIS_VIMRC="$VIMRC"

ELECTRON="$GNOSIS_DIR/web/node_modules/.bin/electron"
if [ "$(uname -s)" = Darwin ] && [ -x "$GNOSIS_DIR/web/node_modules/electron/dist/Electron.app/Contents/MacOS/Electron" ]; then
  ELECTRON="$GNOSIS_DIR/web/node_modules/electron/dist/Electron.app/Contents/MacOS/Electron"
fi

graphical() {
  [ "$(uname -s)" = Darwin ] && return 0
  [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]
}

find_vim() {
  if [ -n "${GNOSIS_VIM:-}" ]; then echo "$GNOSIS_VIM"; return; fi
  for v in vim /usr/local/bin/vim /opt/homebrew/bin/vim /usr/bin/vim; do
    if command -v "$v" >/dev/null 2>&1; then command -v "$v"; return; fi
  done
  echo vim
}

find_gvim() {
  if [ "$(uname -s)" = Darwin ]; then
    for m in mvim "/Applications/MacVim.app/Contents/bin/mvim" "$HOME/Applications/MacVim.app/Contents/bin/mvim"; do
      if command -v "$m" >/dev/null 2>&1 || [ -x "$m" ]; then echo "$m"; return; fi
    done
    return 1
  fi
  command -v gvim 2>/dev/null || return 1
}

# vault の設定（最後に選んだ vault）から 1 つの値を読む: fontSize / maximized
setting() {
  py=$(command -v python3 || command -v python || true)
  [ -n "$py" ] || return 0
  "$py" - "$GNOSIS_HOME/vaults.json" "$1" <<'PY' 2>/dev/null || true
import json, os, sys
try:
    reg = json.load(open(sys.argv[1], encoding="utf-8"))
    s = json.load(open(os.path.join(reg.get("last", ""), ".gnosis", "settings.json"), encoding="utf-8"))
except Exception:
    s = {}
key = sys.argv[2]
if key == "fontSize":
    print(int(s.get("fontSize", 16)))
elif key == "maximized":
    print("1" if s.get("window", {}).get("maximized", True) else "0")
PY
}

run_tui() { exec "$(find_vim)" -u "$VIMRC" "$@"; }

run_gui() {
  g=$(find_gvim) || { echo "gnosis: GUI 版 Vim が見つかりません / GUI Vim not found" >&2; exit 1; }
  exec "$g" -u "$VIMRC" -U NONE "$@"
}

run_app() {
  if [ ! -x "$ELECTRON" ]; then
    echo "gnosis: アプリが入っていません。install/install.sh を実行してください / the app is not installed" >&2
    return 1
  fi
  if [ $# -ge 1 ] && [ -f "$1" ]; then
    GNOSIS_FILE=$(CDPATH= cd -- "$(dirname -- "$1")" && pwd)/$(basename -- "$1")
    export GNOSIS_FILE
  fi
  if [ "$(uname -s)" = Darwin ]; then
    exec "$ELECTRON" "$GNOSIS_DIR/web"
  fi
  # --no-sandbox: 環境によってはサンドボックスで起動できない
  # --ozone-platform=x11 --disable-gpu: KDE Wayland で窓が出ないことがある問題の回避（XWayland）
  exec "$ELECTRON" "$GNOSIS_DIR/web" --no-sandbox --ozone-platform=x11 --disable-gpu
}

run_new_terminal() {
  vim=$(find_vim)
  size=$(setting fontSize); size=${size:-16}
  max=$(setting maximized); max=${max:-1}
  if [ "$(uname -s)" = Darwin ]; then
    # Terminal.app の文字サイズは、その端末のプロファイルの設定のまま
    q=$(printf '%s' "$vim -u '$VIMRC'" | sed 's/"/\\"/g')
    exec osascript -e "tell application \"Terminal\" to do script \"$q\"" -e 'tell application "Terminal" to activate'
  fi
  term=${GNOSIS_TERMINAL:-}
  if [ -z "$term" ]; then
    for t in kitty alacritty wezterm xterm gnome-terminal konsole xfce4-terminal x-terminal-emulator; do
      if command -v "$t" >/dev/null 2>&1; then term=$t; break; fi
    done
  fi
  case "$term" in
    kitty)
      if [ "$max" = 1 ]; then exec kitty -o "font_size=$size" --start-as=maximized "$vim" -u "$VIMRC" "$@"; fi
      exec kitty -o "font_size=$size" "$vim" -u "$VIMRC" "$@" ;;
    alacritty)
      mode=Windowed; [ "$max" = 1 ] && mode=Maximized
      exec alacritty -o "font.size=$size" -o "window.startup_mode=$mode" -e "$vim" -u "$VIMRC" "$@" ;;
    wezterm)
      exec wezterm --config "font_size=$size" start -- "$vim" -u "$VIMRC" "$@" ;;
    xterm)
      if [ "$max" = 1 ]; then exec xterm -maximized -fa Monospace -fs "$size" -e "$vim" -u "$VIMRC" "$@"; fi
      exec xterm -fa Monospace -fs "$size" -e "$vim" -u "$VIMRC" "$@" ;;
    gnome-terminal)
      if [ "$max" = 1 ]; then exec gnome-terminal --maximize -- "$vim" -u "$VIMRC" "$@"; fi
      exec gnome-terminal -- "$vim" -u "$VIMRC" "$@" ;;
    xfce4-terminal)
      # XFCE Terminal は --font を新規ウィンドウに渡せる。
      # 既存ウィンドウのフォントは Vim から直接は変更できない。
      if [ "$max" = 1 ]; then exec xfce4-terminal --font "Monospace $size" --maximize -x "$vim" -u "$VIMRC" "$@"; fi
      exec xfce4-terminal --font "Monospace $size" -x "$vim" -u "$VIMRC" "$@" ;;
    konsole) exec konsole -e "$vim" -u "$VIMRC" "$@" ;;
    "") echo "gnosis: 端末エミュレーターが見つかりません / no terminal emulator found" >&2; exit 1 ;;
    *) exec "$term" -e "$vim" -u "$VIMRC" "$@" ;;
  esac
}

mode=auto
case "${1:-}" in
  --app) mode=app; shift ;;
  --gui) mode=gui; shift ;;
  --tui|--terminal) mode=tui; shift ;;
  --new-terminal) mode=newterm; shift ;;
  --where)
    printf 'Gnosis: %s\nGnosis home: %s\nvimrc: %s\nvim: %s\n' "$GNOSIS_DIR" "$GNOSIS_HOME" "$VIMRC" "$(find_vim)"
    exit 0 ;;
  -h|--help)
    sed -n '2,20p' "$self" | sed 's/^# \{0,1\}//'
    exit 0 ;;
esac

case "$mode" in
  app) run_app "$@" ;;
  gui) run_gui "$@" ;;
  tui) run_tui "$@" ;;
  newterm) run_new_terminal "$@" ;;
  auto)
    # デフォルトは必ず本物の端末 Vim。Electron / gvim を自動選択しない。
    if [ -t 0 ] && [ -t 1 ]; then run_tui "$@"; fi
    run_new_terminal "$@" ;;
esac
