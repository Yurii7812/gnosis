#!/bin/sh
# Gnosis のランチャー（Linux / macOS）。
#
#   gnosis                 Gnosis 専用端末ウィンドウを開く（文字サイズなどを適用）。現在の端末はそのまま
#   gnosis --new-terminal  新しい端末の窓を開いて、その中の Vim で起動（アイコンはこれ）
#   gnosis --tui           今の端末の Vim で起動（--terminal も同じ）
#   gnosis --gui           GUI 版 Vim（gvim / MacVim）で起動
#   gnosis --app           旧 Electron アプリを明示したときだけ起動（任意）
#   gnosis [ノート.md …]   そのノートを開く（起動画面は出さない）
#   gnosis --where         どの Gnosis が起動するか（本体のフォルダ・コミット・Gnosis ホーム・vimrc・Vim）
#   gnosis --doctor        導入の診断（古いランチャー・アプリメニュー・必要なもの・文字サイズ）
#   gnosis --update        origin/main の最新版へ安全に更新し、Gnosis専用環境・ランチャーも再構築
#   gnosis --version       本体のコミット
#
# Vim は、Gnosis 専用の vimrc（<Gnosis ホーム>/vimrc。無ければ本体の vimrc_gnosis）で起動する。
# ふだんの ~/.vimrc・~/.vim は読まない・変えない。ふつうに vim を起動すれば今までどおり。
#
# 文字サイズ: 端末の文字を描くのは端末エミュレーター。Gnosis ホームの terminal.json の大きさを、
# --new-terminal で開く窓に渡す（Konsole・kitty・Alacritty・WezTerm・XFCE Terminal・xterm）。
# Konsole は Gnosis 専用プロファイルを絶対パスで指定し、-p Font でも大きさを明示する。
# Gnosis 専用プロファイルだけに適用し、通常の Konsole と Vim は変更しない。
# 端末の窓を開けなかったときの記録: <Gnosis ホーム>/logs/launcher.log
set -eu

# ---- このファイルの場所（シンボリックリンクをたどる）から Gnosis のフォルダを求める
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
GNOSIS_DIR=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)
SELF="$GNOSIS_DIR/bin/gnosis"
export GNOSIS_DIR

if [ -n "${GNOSIS_HOME:-}" ]; then
  :
elif [ "$(uname -s)" = Darwin ]; then
  GNOSIS_HOME="$HOME/Library/Application Support/Gnosis"
else
  GNOSIS_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/gnosis"
fi
export GNOSIS_HOME

if [ -n "${GNOSIS_VIMRC:-}" ]; then
  VIMRC=$GNOSIS_VIMRC
elif [ -f "$GNOSIS_HOME/vimrc" ]; then
  VIMRC="$GNOSIS_HOME/vimrc"
else
  VIMRC="$GNOSIS_DIR/vimrc_gnosis"
fi
export GNOSIS_VIMRC="$VIMRC"

ELECTRON="$GNOSIS_DIR/web/node_modules/.bin/electron"
if [ "$(uname -s)" = Darwin ] && [ -x "$GNOSIS_DIR/web/node_modules/electron/dist/Electron.app/Contents/MacOS/Electron" ]; then
  ELECTRON="$GNOSIS_DIR/web/node_modules/electron/dist/Electron.app/Contents/MacOS/Electron"
fi

LOG="$GNOSIS_HOME/logs/launcher.log"
log() {
  mkdir -p "$GNOSIS_HOME/logs" 2>/dev/null || return 0
  printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*" >> "$LOG" 2>/dev/null || true
}

have() { command -v "$1" >/dev/null 2>&1; }

find_vim() {
  if [ -n "${GNOSIS_VIM:-}" ]; then echo "$GNOSIS_VIM"; return; fi
  for v in vim /usr/local/bin/vim /opt/homebrew/bin/vim /usr/bin/vim; do
    if command -v "$v" >/dev/null 2>&1; then command -v "$v"; return; fi
  done
  echo vim
}

find_gvim() {
  if [ "$(uname -s)" = Darwin ]; then
    for m in mvim "/Applications/MacVim.app/Contents/bin/mvim" "$HOME/Applications/MacVim.app/Contents/bin/mvim"; do
      if command -v "$m" >/dev/null 2>&1 || [ -x "$m" ]; then echo "$m"; return; fi
    done
    return 1
  fi
  command -v gvim 2>/dev/null || return 1
}

# ---- 文字サイズなど（<Gnosis ホーム>/terminal.json。Gnosis が書く JSON なので sed で読める）
tf_get() { # キー 既定値
  f="$GNOSIS_HOME/terminal.json"
  v=""
  if [ -f "$f" ]; then
    v=$(sed -n "s/^[[:space:]]*\"$1\":[[:space:]]*\"\{0,1\}\([^\",]*\)\"\{0,1\},\{0,1\}[[:space:]]*$/\1/p" "$f" | head -1)
  fi
  if [ -z "$v" ] && [ "$1" = fontSize ]; then v=$(legacy_font_size); fi
  [ -n "$v" ] && printf '%s' "$v" || printf '%s' "$2"
}

# 以前の版は文字サイズを最後の vault の設定（.gnosis/settings.json）にだけ保存していた
legacy_font_size() {
  py=$(command -v python3 || command -v python || true)
  [ -n "$py" ] || return 0
  "$py" - "$GNOSIS_HOME/vaults.json" <<'PY' 2>/dev/null || true
import json, os, sys
try:
    reg = json.load(open(sys.argv[1], encoding="utf-8"))
    s = json.load(open(os.path.join(reg.get("last", ""), ".gnosis", "settings.json"), encoding="utf-8"))
    print(int(s["fontSize"]))
except Exception:
    pass
PY
}

# 最大化（最後の vault の設定。読めなければ最大化する）
maximized() {
  py=$(command -v python3 || command -v python || true)
  [ -n "$py" ] || { echo 1; return; }
  "$py" - "$GNOSIS_HOME/vaults.json" <<'PY' 2>/dev/null || echo 1
import json, os, sys
try:
    reg = json.load(open(sys.argv[1], encoding="utf-8"))
    s = json.load(open(os.path.join(reg.get("last", ""), ".gnosis", "settings.json"), encoding="utf-8"))
    print("1" if s.get("window", {}).get("maximized", True) else "0")
except Exception:
    print("1")
PY
}

# フォント: terminal.json の fontFamily。空なら、読みやすい等幅フォントを入っているものから選ぶ
# （日本語の文字は端末がフォントの置き換えで描く。Noto Sans CJK JP が入っていればブラウザと同じ字形）。
# 日本語用の等幅フォント（Noto Sans Mono CJK JP など）を先にしない: 起動画面の Chnoubis の点字（U+2800〜）を
# 持たず、置き換えのフォントと幅が合わずに図案が崩れる（Hack は DejaVu 由来で、置き換えの点字と幅が揃う）。
# どれも無ければ fc-match の monospace。
font_family() {
  f=$(tf_get fontFamily "")
  if [ -z "$f" ] && have fc-list; then
    for c in "Hack" "DejaVu Sans Mono" "Noto Sans Mono" "Liberation Mono" "Ubuntu Mono" "Source Code Pro" "Menlo"; do
      if [ -n "$(fc-list "$c" family 2>/dev/null | head -1)" ]; then f=$c; break; fi
    done
  fi
  if [ -z "$f" ] && have fc-match; then f=$(fc-match -f '%{family[0]}' monospace 2>/dev/null || true); fi
  [ -n "$f" ] || f=Monospace
  printf '%s' "$f"
}

# ---- Gnosis の窓に使う端末（GNOSIS_TERMINAL > terminal.json > デスクトップに合うもの > 見つかったもの）
pick_terminal() {
  t=${GNOSIS_TERMINAL:-}
  [ -n "$t" ] || t=$(tf_get terminal "")
  if [ -n "$t" ] && have "$t"; then echo "$t"; return; fi
  [ -z "$t" ] || log "terminal '$t' not found; choosing automatically"
  desk=${XDG_CURRENT_DESKTOP:-${DESKTOP_SESSION:-}}
  case "$desk" in
    *KDE*|*kde*|*plasma*) pref=konsole ;;
    *XFCE*|*xfce*) pref=xfce4-terminal ;;
    *GNOME*|*gnome*|*Unity*|*Cinnamon*|*ubuntu*) pref=gnome-terminal ;;
    *) pref="" ;;
  esac
  for t in wezterm $pref kitty alacritty konsole xfce4-terminal ghostty foot gnome-terminal xterm x-terminal-emulator; do
    if have "$t"; then echo "$t"; return; fi
  done
}

# ---- Dedicated WezTerm config; never load or change ~/.wezterm.lua.
wezterm_config() {
  out="$GNOSIS_HOME/terminal/wezterm.lua"
  mkdir -p "$GNOSIS_HOME/terminal"
  cat > "$out" <<'LUA'
local wezterm = require 'wezterm'
return {
  font = wezterm.font(os.getenv('GNOSIS_FONT_FAMILY') or 'Monospace'),
  font_size = tonumber(os.getenv('GNOSIS_FONT_SIZE')) or 16,
  line_height = tonumber(os.getenv('GNOSIS_LINE_HEIGHT')) or 1.10,
  colors = {
    background = '#1E1E1E', foreground = '#DADADA',
    cursor_bg = '#6CB6FF', cursor_fg = '#1E1E1E',
    selection_bg = '#21538C', selection_fg = '#EBEBEB',
  },
  enable_tab_bar = false,
  use_fancy_tab_bar = false,
}
LUA
  printf '%s' "$out"
}

# ---- Konsole: Gnosis 専用プロファイル（Gnosis-<大きさ>）と配色を Gnosis ホームに作る。
# この窓にだけ XDG_DATA_DIRS で見せるので、ふだんの Konsole の一覧・設定は変わらない。
# 大きさごとのプロファイルを全部作るのは、Konsole が起動時に読んだプロファイルにしか
# 切り替えられないため（設定画面の + / - でその場で切り替える）。
konsole_profiles() {
  dir="$GNOSIS_HOME/terminal/share/konsole"
  mkdir -p "$dir"
  fam=$(font_family | tr -d ',')
  ls_=$(tf_get lineSpacing 2)
  cat > "$dir/Gnosis.colorscheme" <<'EOF'
[General]
Description=Gnosis
Opacity=1

[Background]
Color=34,39,46

[BackgroundIntense]
Color=45,51,59

[Foreground]
Color=205,213,222

[ForegroundIntense]
Color=255,255,255

[Color0]
Color=34,39,46

[Color0Intense]
Color=84,93,104

[Color1]
Color=255,138,138

[Color1Intense]
Color=255,170,170

[Color2]
Color=143,227,168

[Color2Intense]
Color=180,240,198

[Color3]
Color=246,216,138

[Color3Intense]
Color=255,230,170

[Color4]
Color=92,208,255

[Color4Intense]
Color=150,225,255

[Color5]
Color=200,170,255

[Color5Intense]
Color=220,200,255

[Color6]
Color=121,207,255

[Color6Intense]
Color=188,238,255

[Color7]
Color=205,213,222

[Color7Intense]
Color=255,255,255
EOF
  s=6
  while [ "$s" -le 48 ]; do
    cat > "$dir/Gnosis-$s.profile" <<EOF
[General]
Name=Gnosis-$s
Parent=FALLBACK/

[Appearance]
ColorScheme=Gnosis
Font=$fam,$s,-1,5,50,0,0,0,0,0
LineSpacing=$ls_
AntiAliasFonts=true

[Scrolling]
ScrollBarPosition=2
EOF
    s=$((s + 1))
  done
}

run_tui() {
  vim=$(find_vim)
  if [ -n "${GNOSIS_TERMINAL_KIND:-}" ]; then
    # Gnosis が開いた窓の中: 端末のために変えた環境変数を戻す
    if [ "${GNOSIS_ORIG_XDG_DATA_DIRS-__unset__}" = __unset__ ]; then
      :
    elif [ -z "$GNOSIS_ORIG_XDG_DATA_DIRS" ]; then
      unset XDG_DATA_DIRS
    else
      XDG_DATA_DIRS=$GNOSIS_ORIG_XDG_DATA_DIRS; export XDG_DATA_DIRS
    fi
    unset GNOSIS_ORIG_XDG_DATA_DIRS
    if [ "${GNOSIS_ORIG_XDG_STATE_HOME-__unset__}" != __unset__ ]; then
      if [ -n "$GNOSIS_ORIG_XDG_STATE_HOME" ]; then
        XDG_STATE_HOME=$GNOSIS_ORIG_XDG_STATE_HOME; export XDG_STATE_HOME
      else
        unset XDG_STATE_HOME
      fi
      unset GNOSIS_ORIG_XDG_STATE_HOME
    fi
    # すぐ閉じてしまうと原因が見えないので、Vim が起動できなかったら知らせて待つ
    status=0
    "$vim" -u "$VIMRC" "$@" || status=$?
    if [ "$status" -ne 0 ]; then
      log "vim exited with status $status (vim=$vim vimrc=$VIMRC)"
      printf '\nGnosis: Vim が終了コード %s で終わりました（%s）。記録: %s\nEnter で閉じます / Press Enter to close. ' "$status" "$vim" "$LOG"
      read -r _ || true
    fi
    exit "$status"
  fi
  exec "$vim" -u "$VIMRC" "$@"
}

run_gui() {
  g=$(find_gvim) || { echo "gnosis: GUI 版 Vim が見つかりません / GUI Vim not found" >&2; exit 1; }
  exec "$g" -u "$VIMRC" -U NONE "$@"
}

run_app() {
  # Windows(WSL) インストーラーは Node.js を Gnosis 専用の場所に入れる。electron の起動スクリプトが要る。
  if [ -x "$GNOSIS_HOME/node/bin/node" ]; then PATH="$GNOSIS_HOME/node/bin:$PATH"; export PATH; fi
  if [ ! -x "$ELECTRON" ]; then
    echo "gnosis: アプリが入っていません。install/install.sh --app を実行してください / the app is not installed" >&2
    return 1
  fi
  if [ $# -ge 1 ] && [ -f "$1" ]; then
    GNOSIS_FILE=$(CDPATH= cd -- "$(dirname -- "$1")" && pwd)/$(basename -- "$1")
    export GNOSIS_FILE
  fi
  if [ "$(uname -s)" = Darwin ]; then
    exec "$ELECTRON" "$GNOSIS_DIR/web"
  fi
  # 日本語入力: XWayland の Electron は GTK の入力メソッド経由で fcitx5 / ibus と話す。XMODIFIERS だけだと変換が不安定
  # （候補が出ない・確定の Enter が効かないなど）なので、GTK_IM_MODULE を合わせる（利用者が決めていればそのまま）。
  if [ -z "${GTK_IM_MODULE:-}" ]; then
    case "${XMODIFIERS:-}" in
      *@im=fcitx*) GTK_IM_MODULE=fcitx; export GTK_IM_MODULE ;;
      *@im=ibus*) GTK_IM_MODULE=ibus; export GTK_IM_MODULE ;;
    esac
  fi
  # --no-sandbox: 環境によってはサンドボックスで起動できない
  # --ozone-platform=x11 --disable-gpu: KDE Wayland で窓が出ないことがある問題の回避（XWayland）
  exec "$ELECTRON" "$GNOSIS_DIR/web" --no-sandbox --ozone-platform=x11 --disable-gpu
}

# Gnosis が開く Konsole だけを最大化する KWin 6 スクリプト。
# タイトルに Gnosis があるウィンドウのみ対象（他の Konsole を変更しない）。
# スクリプトは起動直前に読み込み、最大化を済ませたら自動的に解除する。
start_gnosis_kwin_maximize() {
  [ "${GNOSIS_DRY_RUN:-0}" != 1 ] || return 0
  [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] || return 0
  script="$GNOSIS_DIR/bin/gnosis-kwin-maximize.js"
  [ -f "$script" ] || { log "maximize: KWin script missing: $script"; return 0; }
  qdbus=""
  for tool in qdbus6 qdbus; do
    if have "$tool"; then qdbus=$tool; break; fi
  done
  [ -n "$qdbus" ] || { log "maximize: qdbus6/qdbus unavailable"; return 0; }
  name=gnosis-konsole-maximize
  "$qdbus" org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript "$name" >/dev/null 2>&1 || true
  if ! "$qdbus" org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript "$script" "$name" >/dev/null 2>&1; then
    log "maximize: could not load KWin script"
    return 0
  fi
  if ! "$qdbus" org.kde.KWin /Scripting org.kde.kwin.Scripting.start >/dev/null 2>&1; then
    log "maximize: could not start KWin script"
  fi
  ( sleep 10
    "$qdbus" org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript "$name" >/dev/null 2>&1 || true
  ) </dev/null >/dev/null 2>&1 &
}

# 端末を起動する。GNOSIS_DRY_RUN=1 のときは起動せず、渡す引数を 1 行ずつ表示する（試験用）
run_term() {
  if [ "${GNOSIS_DRY_RUN:-0}" = 1 ]; then
    printf '%s\n' "$@"
    printf 'env GNOSIS_TERMINAL_KIND=%s XDG_DATA_DIRS=%s XDG_STATE_HOME=%s\n' "${GNOSIS_TERMINAL_KIND:-}" "${XDG_DATA_DIRS:-}" "${XDG_STATE_HOME:-}"
    exit 0
  fi
  exec "$@"
}

fail_window() {
  log "$1"
  echo "gnosis: $1" >&2
  if have notify-send; then notify-send -i gnosis "Gnosis" "$1 ($LOG)" >/dev/null 2>&1 || true; fi
  exit 1
}

run_new_terminal() {
  size=$(tf_get fontSize 16)
  case "$size" in ''|*[!0-9]*) size=16 ;; esac
  max=$(maximized)
  if [ "$(uname -s)" = Darwin ] && ! have wezterm && [ -x "/Applications/WezTerm.app/Contents/MacOS/wezterm" ]; then
    PATH="/Applications/WezTerm.app/Contents/MacOS:$PATH"; export PATH
  fi
  if [ "$(uname -s)" = Darwin ] && ! have wezterm && [ -x "$HOME/Applications/WezTerm.app/Contents/MacOS/wezterm" ]; then
    PATH="$HOME/Applications/WezTerm.app/Contents/MacOS:$PATH"; export PATH
  fi
  if [ "$(uname -s)" = Darwin ] && ! have wezterm; then
    # Terminal.app is the fallback only when WezTerm is not yet installed.
    exec osascript -e 'tell application "Terminal" to do script "'$SELF' --tui"' -e 'tell application "Terminal" to activate'
  fi
  term=$(pick_terminal)
  [ -n "$term" ] || fail_window "端末エミュレーターが見つかりません / no terminal emulator found"
  kind=$(basename "$term")
  GNOSIS_TERMINAL_KIND=$kind
  export GNOSIS_TERMINAL_KIND
  fam=$(font_family)
  lsp=$(tf_get lineSpacing 2)
  GNOSIS_FONT_SIZE=$size; export GNOSIS_FONT_SIZE
  GNOSIS_FONT_FAMILY=$fam; export GNOSIS_FONT_FAMILY
  GNOSIS_LINE_HEIGHT=1.10; export GNOSIS_LINE_HEIGHT
  log "open $kind size=$size font='$fam' maximized=$max gnosis=$GNOSIS_DIR vimrc=$VIMRC"
  # 端末が起動できたかは端末任せ（exec のあと）。起動できなければ launcher.log と通知で分かる
  case "$kind" in
    konsole)
      konsole_profiles
      GNOSIS_ORIG_XDG_DATA_DIRS=${XDG_DATA_DIRS-}
      export GNOSIS_ORIG_XDG_DATA_DIRS
      XDG_DATA_DIRS="$GNOSIS_HOME/terminal/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
      export XDG_DATA_DIRS
      # 通常の Konsole の保存済みウィンドウサイズは Gnosis に引き継がない。
      GNOSIS_ORIG_XDG_STATE_HOME=${XDG_STATE_HOME-}
      export GNOSIS_ORIG_XDG_STATE_HOME
      XDG_STATE_HOME="$GNOSIS_HOME/terminal/state"
      mkdir -p "$XDG_STATE_HOME"
      rm -f "$XDG_STATE_HOME/konsolestaterc"
      export XDG_STATE_HOME
      # --profile の名前検索だけに依存せず、Gnosis のファイルを絶対パスで指定する。
      # -p Font は起動時サイズを明示的に指定する保険。変更はこのセッションのみ。
      if [ "$max" = 1 ]; then start_gnosis_kwin_maximize; fi
      run_term konsole --separate --hide-menubar --hide-tabbar \
        --profile "$GNOSIS_HOME/terminal/share/konsole/Gnosis-$size.profile" \
        -p "Font=$fam,$size,-1,5,50,0,0,0,0,0" \
        -p "LocalTabTitleFormat=Gnosis" \
        -e "$SELF" --tui "$@" ;;
    kitty)
      set -- -o "font_size=$size" -o "font_family=$fam" -o "modify_font=cell_height +${lsp}px" \
        -o allow_remote_control=yes --title Gnosis "$SELF" --tui "$@"
      if [ "$max" = 1 ]; then run_term kitty --start-as=maximized "$@"; fi
      run_term kitty "$@" ;;
    alacritty)
      mode=Windowed; [ "$max" = 1 ] && mode=Maximized
      run_term alacritty -o "font.size=$size" -o "font.normal.family=\"$fam\"" -o "font.offset.y=$lsp" \
        -o "window.startup_mode=\"$mode\"" --title Gnosis -e "$SELF" --tui "$@" ;;
    wezterm)
      conf=$(wezterm_config)
      run_term wezterm --config-file "$conf" start -- "$SELF" --tui "$@" ;;
    xterm)
      if [ "$max" = 1 ]; then
        run_term xterm -maximized -T Gnosis -bg '#1E1E1E' -fg '#DADADA' -fa "$fam" -fs "$size" -e "$SELF" --tui "$@"
      fi
      run_term xterm -T Gnosis -bg '#1E1E1E' -fg '#DADADA' -fa "$fam" -fs "$size" -e "$SELF" --tui "$@" ;;
    gnome-terminal)
      # GNOME Terminal は CLI でフォント指定できないため、Gnosis 専用の
      # GSettings profile を作って適用する。既定/他のプロファイルは変更しない。
      prof=""
      if [ "${GNOSIS_DRY_RUN:-0}" = 1 ]; then
        prof=Gnosis
      elif command -v python3 >/dev/null 2>&1 && command -v gsettings >/dev/null 2>&1; then
        if python3 "$GNOSIS_DIR/python/gnome_font_profile.py" "$GNOSIS_HOME" "$fam" "$size" >/dev/null; then
          prof=Gnosis
        else
          log "GNOME dedicated font profile unavailable; terminal's existing profile will be used"
        fi
      fi
      if [ -n "$prof" ]; then
        if [ "$max" = 1 ]; then run_term gnome-terminal --profile="$prof" --maximize --title Gnosis -- "$SELF" --tui "$@"; fi
        run_term gnome-terminal --profile="$prof" --title Gnosis -- "$SELF" --tui "$@" 
      fi
      if [ "$max" = 1 ]; then run_term gnome-terminal --maximize --title Gnosis -- "$SELF" --tui "$@"; fi
      run_term gnome-terminal --title Gnosis -- "$SELF" --tui "$@" ;;
    foot)
      run_term foot --title Gnosis --font "$fam:size=$size" "$SELF" --tui "$@" ;;
    ghostty)
      run_term ghostty --font-family="$fam" --font-size="$size" -e "$SELF" --tui "$@" ;;
    xfce4-terminal)
      # XFCE Terminal は新しい窓に --font を渡せる（開いている窓の文字は変えられない）
      if [ "$max" = 1 ]; then
        run_term xfce4-terminal --font "$fam $size" --maximize --hide-menubar --hide-toolbar -T Gnosis -x "$SELF" --tui "$@"
      fi
      run_term xfce4-terminal --font "$fam $size" --hide-menubar --hide-toolbar -T Gnosis -x "$SELF" --tui "$@" ;;
    *) run_term "$term" -e "$SELF" --tui "$@" ;;
  esac
}

# ---- コマンド一つで GitHub の main に安全に更新し、Gnosis の環境を再構築。
# 作業中のブランチやノートを勝手に変更せず、旧インストーラーの
# 更新チェック（fetch + ff-only + インストール）をそのまま再利用する。
update_gnosis() {
  if [ "$#" -ne 0 ]; then
    echo "gnosis: --update に追加の引数は指定できません / --update takes no arguments" >&2
    return 2
  fi
  if ! have git || ! git -C "$GNOSIS_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "gnosis: Git 管理された Gnosis が必要です。~/gnosis に clone してから実行してください。" >&2
    return 1
  fi
  git_root=$(git -C "$GNOSIS_DIR" rev-parse --show-toplevel) || return 1
  if [ "$git_root" != "$GNOSIS_DIR" ]; then
    echo "gnosis: Gnosis 本体は Git の独立したリポジトリではありません: $GNOSIS_DIR" >&2
    return 1
  fi
  branch=$(git -C "$GNOSIS_DIR" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
  if [ "$branch" != "main" ]; then
    printf 'gnosis: main ブランチではありません（現在: %s）。\n' "${branch:-detached HEAD}" >&2
    printf '  cd "%s" && git switch main\n' "$GNOSIS_DIR" >&2
    echo "変更を勝手に捨てたり別のブランチへ切り替えたりしません。" >&2
    return 1
  fi
  upstream=$(git -C "$GNOSIS_DIR" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
  if [ "$upstream" != 'origin/main' ]; then
    printf 'gnosis: 更新元が origin/main ではありません（現在: %s）。\n' "${upstream:-未設定}" >&2
    echo '  git branch -u origin/main main で追跡ブランチを設定してください。' >&2
    return 1
  fi
  if [ ! -f "$GNOSIS_DIR/install/install.sh" ]; then
    echo "gnosis: install/install.sh がありません / installer missing" >&2
    return 1
  fi
  printf 'Gnosis: origin/main を確認し、最新版に更新して再インストールします。\n'
  printf 'Gnosis: 本体 %s / ノートや通常の Vim 設定は変更しません。\n' "$GNOSIS_DIR"
  # --yes は確認なし、--no-system はシステムパッケージのインストールなし。
  # installer 自身がローカル変更・fetch 失敗・分岐を確認し、危険な更新を止める。
  exec sh "$GNOSIS_DIR/install/install.sh" --yes --no-system
}

# ---- どの Gnosis が起動するか
git_info() {
  if have git && { [ -d "$GNOSIS_DIR/.git" ] || [ -f "$GNOSIS_DIR/.git" ]; }; then
    c=$(git -C "$GNOSIS_DIR" rev-parse --short HEAD 2>/dev/null || echo '?')
    b=$(git -C "$GNOSIS_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')
    printf '%s (%s)' "$c" "$b"
  else
    printf '(git 管理外 / not a git checkout)'
  fi
}

where() {
  printf 'Gnosis:        %s\n' "$GNOSIS_DIR"
  printf 'commit:        %s\n' "$(git_info)"
  printf 'launcher:      %s\n' "$SELF"
  printf 'Gnosis home:   %s\n' "$GNOSIS_HOME"
  printf 'vimrc:         %s\n' "$VIMRC"
  if [ -f "$VIMRC" ] && [ "$VIMRC" != "$GNOSIS_DIR/vimrc_gnosis" ]; then
    src=$(sed -n "s/^execute 'source ' \. fnameescape('\(.*\)')$/\1/p" "$VIMRC" | head -1 | sed "s/''/'/g")
    [ -z "$src" ] || printf '  -> sources:   %s\n' "$src"
  fi
  printf 'vim:           %s\n' "$(find_vim)"
}

doctor() {
  ok=0; warn=0; bad=0
  pass() { printf '  OK    %s\n' "$*"; ok=$((ok + 1)); }
  note() { printf '  注意  %s\n' "$*"; warn=$((warn + 1)); }
  ng() { printf '  NG    %s\n' "$*"; bad=$((bad + 1)); }
  echo "Gnosis --doctor"
  where | sed 's/^/  /'
  echo
  echo "[本体の版 / version]"
  if have git && git -C "$GNOSIS_DIR" rev-parse HEAD >/dev/null 2>&1; then
    if [ -n "$(git -C "$GNOSIS_DIR" status --porcelain --untracked-files=no 2>/dev/null)" ]; then
      note "本体に未コミットの変更があります（更新時は残します）: $GNOSIS_DIR"
    fi
    up=$(git -C "$GNOSIS_DIR" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
    if [ -n "$up" ]; then
      if [ "${GNOSIS_DOCTOR_FETCH:-1}" = 1 ]; then git -C "$GNOSIS_DIR" fetch --quiet 2>/dev/null || note "GitHub に接続できず、最新か確かめられません（前回取得した情報で比べます）"; fi
      behind=$(git -C "$GNOSIS_DIR" rev-list --count "HEAD..$up" 2>/dev/null || echo 0)
      ahead=$(git -C "$GNOSIS_DIR" rev-list --count "$up..HEAD" 2>/dev/null || echo 0)
      if [ "$behind" -gt 0 ]; then
        ng "$up より $behind コミット古い。更新: cd '$GNOSIS_DIR' && git pull --ff-only && ./install/install.sh"
      else
        pass "$up と同じか新しい（ahead $ahead）"
      fi
    else
      note "追跡するブランチがありません（最新か確かめられません）"
    fi
  else
    note "git 管理外のため版を確かめられません"
  fi
  echo
  echo "[起動に使われるランチャー / launchers on PATH]"
  first=""; seen=":"
  oldifs=$IFS; IFS=:; set -f
  for p in $PATH; do
    IFS=$oldifs
    case "$seen" in *":$p:"*) continue ;; esac
    seen="$seen$p:"
    [ -x "$p/gnosis" ] || continue
    tgt=$(sed -n "s/^exec '\(.*\)' \"\$@\"$/\1/p" "$p/gnosis" 2>/dev/null | head -1)
    [ -n "$tgt" ] || tgt=$(cd "$p" && readlink -f gnosis 2>/dev/null || echo "$p/gnosis")
    if [ -z "$first" ]; then
      first=$tgt
      if [ "$tgt" = "$SELF" ]; then pass "$p/gnosis -> $tgt"; else ng "$p/gnosis -> $tgt（この本体 $SELF ではありません）"; fi
    else
      note "後ろにもあります（使われません）: $p/gnosis -> $tgt"
    fi
  done
  IFS=$oldifs; set +f
  [ -n "$first" ] || note "PATH に gnosis がありません（~/.local/bin を PATH に入れてください）"
  echo
  echo "[アプリメニュー / desktop entry]"
  if [ "$(uname -s)" != Darwin ]; then
    de="${XDG_DATA_HOME:-$HOME/.local/share}/applications/gnosis.desktop"
    if [ -f "$de" ]; then
      ex=$(sed -n 's/^Exec=//p' "$de" | head -1)
      case "$ex" in
        *--new-terminal*) pass "$de: $ex" ;;
        *) ng "$de が古い形式です（$ex）。./install/install.sh をもう一度実行すると直ります" ;;
      esac
      if grep -q '^Terminal=true' "$de"; then note "Terminal=true（端末をデスクトップ任せにしています）"; fi
    else
      note "アプリメニューの項目がありません（./install/install.sh で作れます）"
    fi
    for old in simple-yurii-note.desktop yurii-note.desktop; do
      f="${XDG_DATA_HOME:-$HOME/.local/share}/applications/$old"
      [ -f "$f" ] && note "旧版の項目があります（消していません）: $f"
    done
  fi
  echo
  echo "[必要なもの / requirements]"
  vim=$(find_vim)
  if have "$vim"; then
    vv=$("$vim" --version 2>/dev/null)
    miss=""
    for f in job channel timers textprop popupwin; do printf '%s' "$vv" | grep -q "+$f" || miss="$miss +$f"; done
    if [ -z "$miss" ]; then pass "Vim: $vim ($(printf '%s' "$vv" | head -1 | sed 's/ (.*//'))"; else ng "Vim に足りない機能:$miss ($vim)"; fi
    printf '%s' "$vv" | grep -q '+clipboard' || note "Vim が -clipboard（PC のクリップボードは wl-copy / xclip / xsel を使います）"
  else
    ng "Vim がありません"
  fi
  py=$(command -v python3 || true)
  if [ -n "$py" ]; then
    pass "Python 3: $py"
    if "$py" -c 'import pykakasi' >/dev/null 2>&1 || { [ -x "$GNOSIS_HOME/venv/bin/python" ] && "$GNOSIS_HOME/venv/bin/python" -c 'import pykakasi' >/dev/null 2>&1; }; then
      pass "pykakasi（よみ順の並べ替え）"
    else
      note "pykakasi が無い（よみ順の並べ替えは文字コード順になります）"
    fi
    "$py" -c 'import tkinter' >/dev/null 2>&1 || note "tkinter が無い（紙の日記の取り込み画面 \\F が使えません）"
  else
    ng "Python 3 がありません（リンクの同期・検索が動きません）"
  fi
  if have fzf || [ -x "$GNOSIS_HOME/plugins/fzf/bin/fzf" ]; then pass "fzf"; else ng "fzf がありません（検索）"; fi
  have rg && pass "ripgrep" || note "ripgrep が無い（全文検索が遅くなります）"
  have git && pass "git" || note "git が無い（テーマの追加・更新ができません）"
  for p in fzf fzf.vim vim-surround; do
    [ -d "$GNOSIS_HOME/plugins/$p" ] && pass "Gnosis 専用プラグイン: $p" || note "Gnosis 専用プラグインがありません: $p（./install/install.sh）"
  done
  if have gocryptfs; then pass "gocryptfs（暗号化 vault）"; else note "gocryptfs が無い（暗号化 vault を使うときだけ必要）"; fi
  if [ "$(uname -s)" != Darwin ]; then
    have fusermount3 || have fusermount || note "fusermount が無い（暗号化 vault を使うときだけ必要）"
  fi
  echo
  echo "[文字サイズ / font]"
  printf '  terminal.json: %s\n' "$GNOSIS_HOME/terminal.json"
  printf '  文字サイズ %s / フォント %s / 行間 %s\n' "$(tf_get fontSize 16)" "$(font_family)" "$(tf_get lineSpacing 2)"
  t=$(pick_terminal || true)
  printf '  アイコンから開く端末: %s\n' "${t:-（見つかりません）}"
  case "$(basename "${t:-none}")" in
    konsole|kitty|alacritty) pass "この端末は Gnosis の窓で文字サイズをその場で変えられます" ;;
    xfce4-terminal|xterm|wezterm) pass "この端末は Gnosis の窓を開くときに文字サイズを渡せます（その場では変わりません）" ;;
    gnome-terminal) note "GNOME Terminal は窓ごとの文字サイズを渡せません（端末のプロファイルのまま）" ;;
    *) note "この端末の文字サイズは Gnosis から変えられません" ;;
  esac
  echo
  printf '結果 / result: OK %s, 注意 %s, NG %s\n' "$ok" "$warn" "$bad"
  [ "$bad" -eq 0 ]
}

mode=auto
case "${1:-}" in
  --app) mode=app; shift ;;
  --gui) mode=gui; shift ;;
  --tui|--terminal) mode=tui; shift ;;
  --new-terminal) mode=newterm; shift ;;
  --where) where; exit 0 ;;
  --doctor) doctor; exit $? ;;
  --update) shift; update_gnosis "$@"; exit $? ;;
  --version) git_info; echo; exit 0 ;;
  -h|--help)
    sed -n '2,24p' "$self" | sed 's/^# \{0,1\}//'
    exit 0 ;;
esac

case "$mode" in
  app) run_app "$@" ;;
  gui) run_gui "$@" ;;
  tui) run_tui "$@" ;;
  newterm) run_new_terminal "$@" ;;
  auto)
    # 端末内からの実行も必ず Gnosis 専用の新しい窓で開く。
    # 現在の端末で開きたい場合は明示的に --tui を指定する。
    # ただし画面（GUI）が無い環境（スマホの Debian・SSH・コンソール）は、窓を開けないので今の端末で開く。
    if [ "$(uname -s)" != Darwin ] && [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && [ -t 0 ]; then
      run_tui "$@"
    else
      run_new_terminal "$@"
    fi ;;
esac
